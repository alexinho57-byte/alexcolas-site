# ─────────────────────────────────────────────────────────────
#  alexcolas.com — configuration serveur (Apache / LiteSpeed)
# ─────────────────────────────────────────────────────────────

# Pas de liste des fichiers si un dossier n'a pas d'index
Options -Indexes

# ── Adresse canonique ────────────────────────────────────────
# HTTPS et suppression du www en UNE seule redirection.
# Deux redirections en chaîne coûtent du référencement,
# d'où la règle unique plutôt que deux règles empilées.
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://alexcolas.com%{REQUEST_URI} [L,R=301]

  # ── Fichiers à ne jamais servir ────────────────────────────
  # Le déploiement Git dépose un dossier .git dans public_html :
  # sans cette règle, l'historique complet du site est lisible.
  #
  # Exception : /.well-known/ doit rester accessible. C'est par ce
  # dossier que Let's Encrypt renouvelle le certificat HTTPS et que
  # certaines vérifications de propriété de domaine se font. Le
  # bloquer casse le renouvellement — en silence, jusqu'au jour où
  # le certificat expire.
  RewriteRule ^\.well-known/ - [L]
  RewriteRule (^|/)\. - [F]

  # ── Démonstrations ─────────────────────────────────────────
  # Les sites de /demos/ sont des projets complets, servis tels
  # qu'ils ont été construits : leurs liens internes pointent vers
  # des .html. On les laisse donc en dehors des règles de réécriture
  # ci-dessous, qui leur imposeraient une redirection 301 à chaque
  # clic. Ces pages portent toutes un noindex et sont exclues dans
  # robots.txt : elles contiennent des données fictives et ne doivent
  # jamais entrer dans l'index.
  RewriteRule ^demos/ - [L]

  # ── Adresses sans .html ────────────────────────────────────
  # Le garde REDIRECT_STATUS empêche ces règles de s'appliquer
  # aux requêtes internes : sans lui, la page 404 partirait en
  # boucle de redirection au lieu d'être servie.

  # /index.html → /
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteCond %{THE_REQUEST} \s/+([^?\s]*?)/?index\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]

  # /portfolio.html → /portfolio
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteCond %{THE_REQUEST} \s/+([^?\s]+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]

  # /portfolio sert portfolio.html, sans changer l'adresse affichée
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+?)/?$ /$1.html [L]
</IfModule>

# ── Compression ──────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ── Mise en cache ────────────────────────────────────────────
# Le HTML n'est jamais mis en cache : c'est lui qui porte le
# numéro de version du CSS et du JS (style.css?v=2).
# Ces deux-là peuvent donc être gardés très longtemps : changer
# le numéro dans le HTML crée une nouvelle URL, que ni le
# navigateur ni le cache serveur d'Hostinger ne connaissent.
# Sans ce numéro, une mise à jour du CSS mettrait jusqu'à une
# heure à devenir visible, cache serveur compris.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 hour"
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 30 days"
  ExpiresByType image/png                 "access plus 30 days"
  ExpiresByType image/svg+xml             "access plus 30 days"
  ExpiresByType image/webp                "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # ── Sécurité ───────────────────────────────────────────────
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# ── Page 404 ─────────────────────────────────────────────────
# Servie pour toute URL inexistante, y compris dans un
# sous-dossier : d'où les chemins absolus dans 404.html.
ErrorDocument 404 /404.html

<FilesMatch "^(CLAUDE\.md|\.gitignore|README\.md)$">
    Require all denied
</FilesMatch>
