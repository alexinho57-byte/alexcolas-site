# ─────────────────────────────────────────────────────────────
#  alexcolas.com — configuration serveur (Apache / LiteSpeed)
# ─────────────────────────────────────────────────────────────

# Pas de liste des fichiers si un dossier n'a pas d'index
Options -Indexes

# ── Adresse canonique ────────────────────────────────────────
# HTTPS et suppression du www en UNE seule redirection.
# Deux redirections en chaîne coûtent du référencement,
# d'où la règle unique plutôt que deux règles empilées.
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://alexcolas.com%{REQUEST_URI} [L,R=301]
</IfModule>

# ── Fichiers à ne jamais servir ──────────────────────────────
# Le déploiement Git dépose un dossier .git dans public_html :
# sans cette règle, l'historique complet du site est lisible.
<IfModule mod_rewrite.c>
  RewriteRule (^|/)\. - [F]
</IfModule>

# ── Compression ──────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ── Mise en cache ────────────────────────────────────────────
# Le HTML n'est jamais mis en cache : c'est lui qui porte le
# numéro de version du CSS et du JS (style.css?v=2).
# Ces deux-là peuvent donc être gardés très longtemps : changer
# le numéro dans le HTML crée une nouvelle URL, que ni le
# navigateur ni le cache serveur d'Hostinger ne connaissent.
# Sans ce numéro, une mise à jour du CSS mettrait jusqu'à une
# heure à devenir visible, cache serveur compris.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 hour"
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 30 days"
  ExpiresByType image/png                 "access plus 30 days"
  ExpiresByType image/svg+xml             "access plus 30 days"
  ExpiresByType image/webp                "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # ── Sécurité ───────────────────────────────────────────────
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# ── Page 404 ─────────────────────────────────────────────────
# Servie pour toute URL inexistante, y compris dans un
# sous-dossier : d'où les chemins absolus dans 404.html.
ErrorDocument 404 /404.html
